# Copy these names into your deployment provider's secret/environment settings.
# Do not place real credentials in this file or commit a populated .env file.

PATHFORGE_ENV=production
PATHFORGE_DATABASE_PATH=C:\absolute\path\to\pathforge.db
PATHFORGE_ALLOWED_ORIGINS=https://pathforge.example

# Transactional account email (verification, recovery, and security notices).
RESEND_API_KEY=replace-in-deployment-settings
PATHFORGE_FROM_EMAIL=PathForge <accounts@pathforge.example>

# Optional federal job synchronization.
USAJOBS_API_KEY=replace-in-deployment-settings
USAJOBS_USER_AGENT=registration-email@example.com

# Optional CareerOneStop Jobs V2 synchronization. Keep both values server-side.
CAREERONESTOP_USER_ID=replace-in-deployment-settings
CAREERONESTOP_API_TOKEN=replace-in-deployment-settings
